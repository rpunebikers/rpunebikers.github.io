{
  "rules": {
    "scheduledRides": {
      ".read": true,
      ".write": "auth != null",
      "$rideId": {
        "registrations": {
          "$regKey": {
            ".write": "!data.exists() || auth != null",
            ".validate": "newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length < 100"
          }
        }
      }
    },
    "registrations": {
      ".read": "auth != null",
      "$regId": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length < 100"
      }
    }
  }
}
